NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Preferred for current Supabase sb_secret_ keys.
SUPABASE_SECRET_KEY=
# Legacy compatibility fallback. Do not expose either server key through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC secret for daily unique-view deduplication. Use at least 32 random bytes.
# If omitted, the server Supabase secret is used as a transitional fallback.
VIEWER_HASH_SECRET=

# Development-only first-admin bootstrap. Do not configure this in production.
ADMIN_BOOTSTRAP_EMAIL=

# Public production origin used for canonical URLs, robots.txt and sitemap.xml.
# Example: https://rankingwiki.example
NEXT_PUBLIC_SITE_URL=

# Search-engine ownership verification tokens. Configure only values issued by the engine.
# These are rendered as <meta> verification tags by the root Next.js metadata contract.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
